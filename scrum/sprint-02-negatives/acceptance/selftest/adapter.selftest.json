{
  "_readme": "selftest 专用——自证 verify.mjs 自身逻辑没写错，不是真实现。D 场景（进料对账/作恶写入）依赖 Sprint-1 已交付的真梦引擎，selftest 不搭这个复杂度，runDream/runDreamRogue 留空，H-D1~D4 预期为「未答卷」而非绿——这是已知的自测范围缩水，不代表判据设计有问题。",

  "commands": {
    "install": "node scrum/sprint-02-negatives/acceptance/selftest/fake-plugin/install.mjs",
    "sessionEnd": "node scrum/sprint-02-negatives/acceptance/selftest/fake-plugin/session-end.mjs",
    "backfill": "node scrum/sprint-02-negatives/acceptance/selftest/fake-plugin/backfill.mjs {TRANSCRIPTS_DIR} {CWD}",
    "runDream": "",
    "runDreamRogue": ""
  },

  "paths": {
    "negativeDir": ".claude/negatives",
    "negativeLedger": ".claude/negatives/.ledger.jsonl",
    "errorTrace": ".claude/negatives-errors.log",
    "retainRules": ".claude/negatives-rules.md",
    "reportGlob": ".claude/dream/*.md",
    "canUseToolLogGlob": ".claude/dream/*-canUseTool.log"
  },

  "source": {
    "negativeCompressor": "scrum/sprint-02-negatives/acceptance/selftest/fake-plugin/session-end.mjs",
    "scopeGuard": "scrum/sprint-02-negatives/acceptance/selftest/fake-plugin/session-end.mjs"
  },

  "cooldown": {},

  "recursionGuardEnv": { "name": "CLAUDE_INVOKED_BY", "value": "claude-dream" },

  "report": { "feedReconciliationMarker": "" },

  "faultInjection": { "writeFailureEnv": "SELFTEST_WRITE_FAIL" },

  "offlineSelfCheck": {},

  "oversizedPolicy": "selftest 不声明超大稿策略——H-A8 预期为半自动待办，不是缺陷",

  "timeoutMs": 60000
}
